#!/bin/sh
# Runs the tests before every commit; a failing one blocks the commit.
# The app's unit tests always, and the server's checks when the commit
# touches the server or what it serves (server/, web/, rules/).
# Enable once per clone with: git config core.hooksPath .githooks

# Gradle needs Java 17; pick up the Homebrew one if the shell default is older.
if [ -d /opt/homebrew/opt/openjdk@17 ]; then
  export JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
fi

echo "pre-commit: running unit tests..."
./gradlew --quiet test || {
  echo "pre-commit: tests failed — commit blocked. (Bypass in an emergency: git commit --no-verify)"
  exit 1
}

# Asked of git by path, not by matching file names: that also catches a
# page deleted or moved out of web/, and names git prints quoted.
if ! git diff --cached --quiet -- server web rules; then
  echo "pre-commit: running the server's checks..."
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "pre-commit: this commit changes server/, web/ or rules/, and the server's checks need pnpm, which isn't installed. See AGENTS.md (Setup) — commit blocked."
    exit 1
  fi
  if [ ! -d server/node_modules ]; then
    echo "pre-commit: the server's packages aren't installed. Run: (cd server && pnpm install) — commit blocked."
    exit 1
  fi
  (cd server && pnpm --silent check) || {
    echo "pre-commit: the server's checks failed — commit blocked."
    exit 1
  }
fi
