<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The countdowns while a limited app is on screen, with their 50%/90% warnings -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 16 QPR1+: lets the session countdown be a "Live Update"
         (status-bar chip + lock-screen capsule; OxygenOS calls them Live
         Alerts). Granted on install; the user can turn it off under
         Settings > Notifications > Live updates. Ignored on older versions. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Lets us show the system "ignore battery optimizations?" dialog, so
         aggressive OEM battery savers (OxygenOS etc.) don't kill the blocker -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Optional: screen-time stats on the home list and in the app picker;
         granted via the "Usage access" settings page, never a runtime
         prompt. Blocking doesn't need it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Fetches the signed rules for spotting Shorts and Reels
         (rules/v1/rules.signed.json in the repo, from appblock.robinroy.xyz)
         so a redesign is fixed without an app update. A plain download: nothing about the
         phone or its user is sent. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The tick as the limit dialog's steppers change -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Lets us list all launchable apps on Android 11+, and find the
         launcher (the block wall leaves out its home button over a pop-up,
         where the home screen is already showing) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Strict mode: the system apps whose pages could switch the
             blocker off or uninstall AppBlock (Strict.guardedPackages) -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_APPLICATIONS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.app.action.ADD_DEVICE_ADMIN" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.UNINSTALL_PACKAGE" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MANAGE_APP_PERMISSIONS" />
        </intent>
        <intent>
            <action android:name="android.safetycenter.action.SAFETY_CENTER" />
        </intent>
    </queries>

    <!-- allowBackup: Android's Auto Backup copies the app's data (the rules,
         the usage log, onboarding seen) to the user's Google account and
         restores it on a new phone or a reinstall. It's the default, spelled
         out so it stays on. Strict mode's file is left out (backup_rules,
         data_extraction_rules): on a new phone AppBlock isn't a device admin. -->
    <!-- usesCleartextTraffic: HTTPS only, never plain HTTP. The rules fetch
         is the one connection, and it's to an https:// URL; this makes the
         system refuse plain HTTP anyway (also the default since Android 9,
         but it shouldn't hang on a default). -->
    <application
        android:usesCleartextTraffic="false"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="AppBlock"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:forceDarkAllowed="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press shortcuts on the launcher icon -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:label="Choose apps to block" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="Tie yourself to the mast" />

        <!-- Target of the "Don't give up!" launcher shortcut -->
        <activity
            android:name=".DontGiveUpActivity"
            android:exported="false"
            android:label="Don't give up!" />

        <!-- Strict mode: choosing the way out, then the screens to turn it off. -->
        <activity
            android:name=".StrictActivity"
            android:exported="false"
            android:label="Strict mode" />

        <activity
            android:name=".StrictSetupActivity"
            android:exported="false"
            android:label="Strict mode" />

        <!-- Screen time in full, from the home screen's card. -->
        <activity
            android:name=".UsageActivity"
            android:exported="false"
            android:label="Screen time" />

        <!-- One app's screen time and patterns, from a row on the Usage page. -->
        <activity
            android:name=".AppUsageActivity"
            android:exported="false"
            android:label="App usage" />

        <!-- Target of the "Contact support" launcher shortcut -->
        <activity
            android:name=".SupportActivity"
            android:exported="false"
            android:label="Contact support" />

        <!-- Strict mode's device admin. It asks for no admin powers
             (strict_admin.xml): being one is what makes Android refuse to
             uninstall AppBlock. Only the system may send it the admin
             broadcasts (the permission). -->
        <receiver
            android:name=".StrictAdmin"
            android:exported="true"
            android:label="AppBlock"
            android:description="@string/strict_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/strict_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- The clock being set (Clock.check: the usage logs move with it, a
             counting cooldown starts over), and the buttons on strict
             mode's notifications (sent to it by name). -->
        <receiver
            android:name=".StrictReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- adb's way out of strict mode. DUMP: only the shell holds it, no
             app can, so nothing on the phone can send this. -->
        <receiver
            android:name=".EndStrictReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="xyz.robinroy.appblock.END_STRICT" />
            </intent-filter>
        </receiver>

        <!-- The blocker: an accessibility service that sees which apps are on
             screen and draws the block wall over a spent one. Only the
             system may bind to it (the permission); the user switches it on
             in Settings > Accessibility, and the system keeps it running
             and brings it back after a reboot or an update. -->
        <service
            android:name=".BlockerService"
            android:exported="true"
            android:label="AppBlock"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/blocker_service" />
        </service>
    </application>
</manifest>
