<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's picture in the launcher's widget list and its "Add to home
     screen" sheet (Android 12+): the widget's own card, with a made-up day
     in it. Like the widget's face it is a picture the app drew
     (drawable-nodpi/widget_preview.png, and its dark twin): the launcher
     won't load the app's fonts. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_preview" />
</FrameLayout>
